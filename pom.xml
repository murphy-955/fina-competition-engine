<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.murphy955.fina</groupId>
    <artifactId>fina-competition-engine</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>FINA Competition Engine</name>
    <description>A zero-dependency indoor swimming competition engine</description>

    <modules>
        <module>world-aquatics-commons</module>
        <module>world-aquatics-domain</module>
        <module>world-aquatics-rules-engine</module>
        <module>world-aquatics-competition</module>
        <module>world-aquatics-timing</module>
        <module>world-aquatics-scoring</module>
        <module>world-aquatics-data-exchange</module>
        <module>world-aquatics-records</module>
        <module>world-aquatics-officials</module>
        <module>world-aquatics-starter</module>
    </modules>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.10.0</junit.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.murphy955.fina</groupId>
                <artifactId>world-aquatics-commons</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.murphy955.fina</groupId>
                <artifactId>world-aquatics-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.murphy955.fina</groupId>
                <artifactId>world-aquatics-rules-engine</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.murphy955.fina</groupId>
                <artifactId>world-aquatics-competition</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.murphy955.fina</groupId>
                <artifactId>world-aquatics-timing</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.murphy955.fina</groupId>
                <artifactId>world-aquatics-scoring</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.murphy955.fina</groupId>
                <artifactId>world-aquatics-data-exchange</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.murphy955.fina</groupId>
                <artifactId>world-aquatics-records</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.murphy955.fina</groupId>
                <artifactId>world-aquatics-officials</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.11.0</version>
                    <configuration>
                        <source>17</source>
                        <target>17</target>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
